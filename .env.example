LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Leave EMPTY here. Put the real key only in your local .env (never commit).
LLM_API_KEY=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.0
SOLVER_TIME_LIMIT_SECONDS=15
OFFLINE_FALLBACK=true
APP_HOST=0.0.0.0
APP_PORT=8000
VALIDATOR_TOLERANCE=0.01
LOG_LEVEL=INFO
