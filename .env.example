# GridWise environment configuration
# Copy to .env and fill in real values; never commit .env.

# --- LLM provider (openai or openai_compat work out of the box) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.0

# --- Solver tuning ---
SOLVER_TIME_LIMIT_SECONDS=15

# --- Behavior ---
# When true, fall back to a safe no_op interpretation if the LLM call fails.
# Set to false in production to surface LLM failures as HTTP errors.
OFFLINE_FALLBACK=true

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Validation tolerance ---
VALIDATOR_TOLERANCE=0.01

LOG_LEVEL=INFO
